{
  "name": "data-editor-table",
  "version": "0.2.0",
  "description": "Turnkey business-data bulk editor for React",
  "homepage": "https://hitomi.github.io/data-editor-table/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitomi/data-editor-table.git"
  },
  "bugs": {
    "url": "https://github.com/hitomi/data-editor-table/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./locales/zh-CN": {
      "types": "./dist/locales/zh-cn.d.ts",
      "import": "./dist/locales/zh-CN.js"
    },
    "./styles.css": {
      "types": "./dist/styles-entry.d.ts",
      "default": "./dist/styles.css"
    },
    "./structure.css": {
      "types": "./dist/styles-entry.d.ts",
      "default": "./dist/structure.css"
    },
    "./theme.css": {
      "types": "./dist/styles-entry.d.ts",
      "default": "./dist/theme.css"
    }
  },
  "scripts": {
    "build": "vite build && node scripts/copy-style-assets.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "check": "pnpm check:boundaries && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.demo.json --noEmit",
    "check:boundaries": "bash scripts/check-v2-import-boundary.sh",
    "check:package": "bash scripts/check-package-consumer.sh",
    "test": "vitest run",
    "lint": "oxlint src --deny-warnings",
    "prepublishOnly": "pnpm check && pnpm test && pnpm lint && pnpm demo:build && pnpm check:package"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tanstack/react-router": "^1.170.32",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxlint": "^1.78.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
